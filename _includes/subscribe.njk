{%- if metadata.newsletter.buttondown %}
<form class="subscribe"{% if subscribeId %} id="{{ subscribeId }}"{% endif %} action="https://buttondown.com/api/emails/embed-subscribe/{{ metadata.newsletter.buttondown }}" method="post">
  <label for="subscribe-email">Get new posts by email</label>
  <p class="subscribe-note">One email per post, about a day after it goes up. Nothing else, and you can unsubscribe any time.</p>
  <div class="subscribe-row">
    <input type="email" name="email" id="subscribe-email" placeholder="you@example.com" autocomplete="email" required>
    <button type="submit">Subscribe</button>
  </div>
</form>
{%- endif %}
